@model GLMS_ST10104382.Models.Contract

@{
    ViewData["Title"] = "Create Contract";
}

<h1>Create Contract</h1>

<hr />

<div class="row">
    <div class="col-md-8">
        <form asp-action="Create" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group mb-3">
                <label asp-for="ClientId" class="control-label"></label>
                <select asp-for="ClientId" class="form-control" asp-items="ViewBag.ClientId">
                    <option value="">-- Select Client --</option>
                </select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="StartDate"></label>
                <input asp-for="StartDate" class="form-control" type="date" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="EndDate"></label>
                <input asp-for="EndDate" class="form-control" type="date" />
            </div>

            <div class="form-group mb-3">
                <label asp-for="Status"></label>
                <select asp-for="Status" class="form-control" asp-items="ViewBag.StatusOptions"></select>
            </div>

            <div class="form-group mb-3">
                <label asp-for="ServiceLevel"></label>
                <select asp-for="ServiceLevel" class="form-control" asp-items="ViewBag.ServiceLevels"></select>
            </div>

            <div class="form-group mb-3">
                <label>Upload Signed Agreement (PDF only)</label>
                <input type="file" name="signedAgreement" class="form-control" />
            </div>

            <div class="form-group">
                <button type="submit" class="btn btn-success">Create Contract</button>
                <a asp-action="Index" class="btn btn-secondary">Back</a>
            </div>

        </form>
    </div>
</div>
