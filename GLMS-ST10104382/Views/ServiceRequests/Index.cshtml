@model IEnumerable<GLMS_ST10104382.Models.ServiceRequest>

@{
    ViewData["Title"] = "Service Requests";
}

<h1>Service Requests</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Add Service Request</a>
</p>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Client</th>
            <th>Contract ID</th>
            <th>Description</th>
            <th>Cost USD</th>
            <th>Cost ZAR</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Contract?.Client?.Name</td>
                <td>@item.ContractId</td>
                <td>@item.Description</td>
                <td>$@item.Cost</td>
                <td>R @item.ConvertedCostZar</td>
                <td>
                    @if (item.Status == "Completed")
                    {
                        <span class="badge bg-success">Completed</span>
                    }
                    else if (item.Status == "In Progress")
                    {
                        <span class="badge bg-primary">In Progress</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Pending</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>